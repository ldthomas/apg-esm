{
  "name": "apg-esm",
  "version": "1.1.2",
  "type": "module",
  "description": "TypeScript APG, an ABNF Parser Generator",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --silent --coverage",
    "jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsc",
    "generator": "node dist/apg/generator.js",
    "server": "node server.js",
    "docs": "typedoc",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldthomas/apg-esm.git"
  },
  "keywords": [
    "APG",
    "parser",
    "generator",
    "ABNF",
    "SABNF"
  ],
  "author": "Lowell D. Thomas <ldt@sabnf.com> (https://sabnf.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ldthomas/apg-esm/issues"
  },
  "homepage": "https://github.com/ldthomas/apg-esm",
  "jest": {
    "testMatch": [
      "**/__tests__/*.test.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.3.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  }
}
