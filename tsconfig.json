{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": false,
    "allowJs": true,
    "checkJs": false,
    "strict": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
